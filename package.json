{
  "name": "corelink-academy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @corelink/api dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "seed:admin": "pnpm --filter @corelink/api seed:admin",
    "clean": "pnpm -r exec rm -rf dist .next node_modules"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  }
}
