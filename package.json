{
  "name": "corelink-academy",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/check-db.mjs && next dev",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:check": "node scripts/check-db.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-db.mjs",
    "postinstall": "prisma generate",
    "bench:admin": "tsx --env-file=.env scripts/bench-admin.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6",
    "clsx": "^2.1.1",
    "date-fns": "4",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "15",
    "pptxgenjs": "^4.0.1",
    "react": "19",
    "react-dom": "19",
    "web-push": "^3.6.7",
    "zod": "3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/web-push": "^3.6.4",
    "eslint": "9",
    "eslint-config-next": "15",
    "postcss": "^8.5.31",
    "prisma": "6",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "3"
  }
}
