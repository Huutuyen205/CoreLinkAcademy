# File MẪU — được commit lên git, chỉ chứa giá trị giả. Không bao giờ ghi mật khẩu/khóa thật vào đây.
# Chép thành .env (đã bị .gitignore) rồi điền giá trị thật vào .env.
# Mật khẩu có ký tự đặc biệt phải mã hóa URL trong DATABASE_URL: @ → %40, # → %23, : → %3A, / → %2F
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/corelink"
APP_URL="http://localhost:3000"
# Tùy chọn: mật khẩu chung cho tài khoản demo khi chạy pnpm db:seed (≥ 8 ký tự, có chữ và số).
# Điền trong .env, KHÁC mật khẩu MySQL. Để trống thì seed tự sinh và in ra một lần.
SEED_DEMO_PASSWORD=""
# Tùy chọn: DB RIÊNG cho `pnpm test:integration` (đã chạy `prisma migrate deploy`). Không được trỏ vào corelink.
TEST_DATABASE_URL=""
