# File MẪU — được commit lên git, chỉ chứa giá trị giả. Không bao giờ ghi mật khẩu/khóa thật vào đây.
# Chép thành .env (đã bị .gitignore) rồi điền giá trị thật. Trên Vercel: Project → Settings → Environment Variables.
#
# CSDL: PostgreSQL trên Supabase (ADR-005). Lấy chuỗi kết nối ở Supabase Dashboard → nút "Connect" → tab "ORMs" → Prisma.
# Mật khẩu có ký tự đặc biệt phải mã hóa URL: @ → %40, # → %23, : → %3A, / → %2F

# Lúc app chạy: Transaction pooler, cổng 6543, bắt buộc có pgbouncer=true.
# connection_limit = số kết nối Prisma mở tới pooler. =1 thì MỌI query trong một request chạy nối tiếp
# (Promise.all mất tác dụng) và các request xếp hàng chờ nhau — mỗi round-trip tới Supabase ~250 ms.
#   Dev (next dev, một tiến trình):  &connection_limit=5
#   Vercel (mỗi function một tiến trình): &connection_limit=3 (tăng/giảm theo giới hạn client của gói Supabase)
DATABASE_URL="postgresql://postgres.uqyslddttlxnkdxginej:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Cho prisma migrate / seed: Session pooler hoặc Direct connection, cổng 5432
DIRECT_URL="postgresql://postgres.uqyslddttlxnkdxginej:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# URL gốc của web (dev: http://localhost:3000; Vercel: https://<tên>.vercel.app)
APP_URL="http://localhost:3000"

# Tùy chọn: mật khẩu chung cho tài khoản demo khi chạy pnpm db:seed (≥ 8 ký tự, có chữ và số).
# Điền trong .env, KHÁC mật khẩu database. Để trống thì seed tự sinh và in ra một lần.
SEED_DEMO_PASSWORD=""

# Tùy chọn: DB PostgreSQL RIÊNG cho `pnpm test:integration` (đã migrate). Không được trỏ vào DB thật.
TEST_DATABASE_URL=""

# Thông báo đẩy (Web Push, FR-048). Sinh cặp khóa: npx web-push generate-vapid-keys
# Khóa công khai có tiền tố NEXT_PUBLIC_ để trình duyệt đăng ký; khóa bí mật CHỈ đặt ở server (Vercel env).
# Để trống thì tính năng thông báo đẩy tự tắt, thông báo trong hộp thư vẫn chạy.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Nhắc lịch học ngày mai tự động (Vercel Cron 19:00 giờ VN — vercel.json). Chuỗi ngẫu nhiên; trống thì cron tắt.
CRON_SECRET=""

# Trợ lý AI (chatbot, soạn bài, hỗ trợ chấm) — docs/23. Để trống = CHẾ ĐỘ MẪU (không gọi mạng, không tốn tiền).
# AI_PROVIDER: mock | gemini | openai (tương thích OpenAI: Groq, OpenRouter…) | anthropic
AI_PROVIDER=""
AI_API_KEY=""
# Tùy chọn: tên model (trống = mặc định theo nhà cung cấp); địa chỉ API (chỉ cho openai); tắt ép JSON nếu model không hỗ trợ.
AI_MODEL=""
AI_BASE_URL=""
AI_JSON_MODE=""
