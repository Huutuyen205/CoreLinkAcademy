// CoreLink Academy v3 — nguồn sự thật cho dữ liệu. Tài liệu: docs/10-database-and-erd.md
// Mọi thời gian lưu UTC. CSDL: PostgreSQL (Supabase) — ADR-005.

generator client {
  provider        = "prisma-client-js"
  // relationJoins: include/select quan hệ được gộp thành MỘT câu SQL (LATERAL JOIN) thay vì mỗi quan hệ một query.
  // DB ở xa (Supabase, ~250 ms/round-trip) nên số round-trip quyết định thời gian phản hồi — docs/21 §Hiệu năng.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler (6543, pgbouncer) — dùng lúc chạy app
  directUrl = env("DIRECT_URL") // kết nối trực tiếp/session (5432) — dùng cho migrate
}

enum Role {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_DONE
  ENROLLED
  LOST
}

enum LeadActivityType {
  CREATED
  RESUBMITTED
  NOTE
  STATUS_CHANGE
  CONVERTED
}

enum ClassStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MCQ
  SHORT
  ESSAY
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// Trạng thái hồ sơ (khác `UserStatus` là khóa đăng nhập): HS đang học / bảo lưu / đã nghỉ; GV đang dạy / tạm nghỉ / đã nghỉ.
enum MemberStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ScheduleRequestType {
  LEAVE // xin nghỉ buổi dạy → giáo vụ phân công dạy thay hoặc hủy buổi
  RESCHEDULE // đề xuất dời buổi sang thời gian khác
}

enum DocumentKind {
  CURRICULUM // giáo trình chuẩn của trung tâm
  MATERIAL // tài liệu học tập / bài giảng
  LESSON_PLAN // giáo án của giáo viên
}

enum AnnouncementAudience {
  ALL
  STAFF
  TEACHERS
  STUDENTS
  PARENTS
  CLASS
}

enum EvaluationStatus {
  DRAFT
  SENT
}

enum ConversationKind {
  DIRECT
  CLASS
}

model User {
  id                 String       @id @default(cuid())
  email              String?      @unique @db.VarChar(191)
  phone              String?      @unique @db.VarChar(20)
  fullName           String       @db.VarChar(120)
  passwordHash       String       @db.VarChar(255)
  role               Role
  status             UserStatus   @default(ACTIVE)
  mustChangePassword Boolean      @default(false)
  failedLoginCount   Int          @default(0)
  lockedUntil        DateTime?
  studentCode        String?      @unique @db.VarChar(16)
  gradeLevel         Int?         @db.SmallInt
  memberStatus       MemberStatus @default(ACTIVE)
  dateOfBirth        DateTime?    @db.Date
  address            String?      @db.VarChar(255)
  expertise          String?      @db.VarChar(200) // GV: chuyên môn / môn dạy
  profileNote        String?      @db.Text // ghi chú hồ sơ (năng lực đầu vào, mục tiêu…) — chỉ quản lý sửa
  avatarFileId       String?      @unique // ảnh đại diện (FR-051) — mọi người đã đăng nhập xem được
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions                Session[]
  childLinks              Guardianship[]       @relation("ParentLinks")
  parentLinks             Guardianship[]       @relation("StudentLinks")
  teachingClasses         Class[]              @relation("ClassTeacher")
  teachingSessions        ClassSession[]       @relation("SessionTeacher")
  enrollments             Enrollment[]
  attendances             Attendance[]         @relation("AttendanceStudent")
  attendanceMarks         Attendance[]         @relation("AttendanceMarker")
  assignedLeads           Lead[]               @relation("LeadAssignee")
  convertedLeads          Lead[]               @relation("LeadConvertedStudent")
  leadActivities          LeadActivity[]
  createdAssignments      Assignment[]
  submissions             Submission[]         @relation("SubmissionStudent")
  gradedSubmissions       Submission[]         @relation("SubmissionGrader")
  auditLogs               AuditLog[]
  uploadedFiles           StoredFile[]
  scheduleRequests        ScheduleRequest[]    @relation("ScheduleRequestTeacher")
  handledScheduleRequests ScheduleRequest[]    @relation("ScheduleRequestHandler")
  leaveRequests           LeaveRequest[]       @relation("LeaveStudent")
  requestedLeaves         LeaveRequest[]       @relation("LeaveRequester")
  handledLeaves           LeaveRequest[]       @relation("LeaveHandler")
  documents               Document[]
  documentShares          DocumentShare[]
  announcements           Announcement[]
  notifications           Notification[]
  evaluationsReceived     Evaluation[]         @relation("EvaluationStudent")
  evaluationsWritten      Evaluation[]         @relation("EvaluationTeacher")
  conversationMemberships ConversationMember[]
  messages                Message[]
  avatarFile              StoredFile?          @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  pushSubscriptions       PushSubscription[]

  @@index([role, fullName]) // listUsers/listLearners: lọc vai trò + sắp xếp theo tên
  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64) // sha256(token) dạng hex
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // dọn phiên hết hạn
  @@map("sessions")
}

model Guardianship {
  parentId  String
  studentId String
  relation  String   @default("Phụ huynh") @db.VarChar(40)
  createdAt DateTime @default(now())
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("guardianships")
}

model Subject {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(80)
  slug        String         @unique @db.VarChar(80)
  description String         @db.Text
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true) // ngừng sử dụng: ẩn khỏi form công khai và form tạo khóa mới
  courses     Course[]
  leads       Lead[]
  levels      SubjectLevel[]
  documents   Document[]

  @@map("subjects")
}

/// Cấp học (Tiền tiểu học, Tiểu học, THCS, THPT…) — khoảng khối lớp và các môn dạy ở cấp đó.
model EducationLevel {
  id          String         @id @default(cuid())
  name        String         @unique @db.VarChar(60)
  gradeFrom   Int            @db.SmallInt // 0 = tiền tiểu học
  gradeTo     Int            @db.SmallInt
  description String?        @db.VarChar(300)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  subjects    SubjectLevel[]
  documents   Document[]

  @@map("education_levels")
}

model SubjectLevel {
  subjectId String
  levelId   String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     EducationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([subjectId, levelId])
  @@index([levelId])
  @@map("subject_levels")
}

model Course {
  id             String   @id @default(cuid())
  subjectId      String
  title          String   @db.VarChar(160)
  slug           String   @unique @db.VarChar(160)
  summary        String   @db.VarChar(300)
  description    String   @db.Text
  gradeFrom      Int      @db.SmallInt
  gradeTo        Int      @db.SmallInt
  level          String   @db.VarChar(60)
  totalSessions  Int      @db.SmallInt
  sessionMinutes Int      @db.SmallInt
  tuitionVnd     Int?
  outcomes       Json // string[]
  syllabus       Json // { title: string; detail: string }[]
  isPublished    Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subject        Subject  @relation(fields: [subjectId], references: [id])
  classes        Class[]
  leads          Lead[]

  @@index([subjectId, isPublished])
  @@map("courses")
}

model Room {
  id       String         @id @default(cuid())
  name     String         @unique @db.VarChar(60)
  capacity Int            @db.SmallInt
  isActive Boolean        @default(true) // tạm ngừng: không chọn được cho lớp/buổi mới
  note     String?        @db.VarChar(255)
  classes  Class[]
  sessions ClassSession[]

  @@map("rooms")
}

model Class {
  id             String          @id @default(cuid())
  code           String          @unique @db.VarChar(30)
  courseId       String
  teacherId      String
  roomId         String?
  startDate      DateTime        @db.Date
  weekdays       String          @db.VarChar(20) // "1,3,5" — 1 = Thứ Hai … 7 = Chủ nhật
  startTime      String          @db.Char(5) // "18:00" giờ Việt Nam
  endTime        String          @db.Char(5)
  totalSessions  Int             @db.SmallInt
  capacity       Int             @db.SmallInt
  status         ClassStatus     @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course          @relation(fields: [courseId], references: [id])
  teacher        User            @relation("ClassTeacher", fields: [teacherId], references: [id])
  room           Room?           @relation(fields: [roomId], references: [id])
  sessions       ClassSession[]
  enrollments    Enrollment[]
  assignments    Assignment[]
  documentShares DocumentShare[]
  announcements  Announcement[]
  evaluations    Evaluation[]
  conversation   Conversation?

  @@index([teacherId])
  @@index([courseId, status])
  @@index([status, startDate]) // danh sách lớp lọc trạng thái, sắp xếp ngày khai giảng; đếm lớp theo trạng thái
  @@index([roomId]) // kiểm tra phòng đang dùng trước khi xóa
  @@map("classes")
}

model ClassSession {
  id               String            @id @default(cuid())
  classId          String
  index            Int               @db.SmallInt
  startsAt         DateTime
  endsAt           DateTime
  teacherId        String
  roomId           String?
  status           SessionStatus     @default(SCHEDULED)
  cancelReason     String?           @db.VarChar(255)
  isMakeup         Boolean           @default(false) // buổi học bù do giáo vụ thêm
  note             String?           @db.VarChar(255)
  class            Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher          User              @relation("SessionTeacher", fields: [teacherId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  attendances      Attendance[]
  scheduleRequests ScheduleRequest[]
  leaveRequests    LeaveRequest[]
  documents        Document[]

  @@unique([classId, index])
  @@index([teacherId, startsAt])
  @@index([roomId, startsAt])
  @@index([startsAt])
  @@map("class_sessions")
}

model Enrollment {
  id         String           @id @default(cuid())
  classId    String
  studentId  String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@map("enrollments")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  note       String?          @db.VarChar(255)
  markedById String
  markedAt   DateTime         @default(now())
  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    User             @relation("AttendanceStudent", fields: [studentId], references: [id])
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

model Lead {
  id                 String         @id @default(cuid())
  parentName         String         @db.VarChar(120)
  phone              String         @db.VarChar(20)
  email              String?        @db.VarChar(191)
  studentName        String         @db.VarChar(120)
  gradeLevel         Int?           @db.SmallInt
  subjectId          String?
  courseId           String?
  note               String?        @db.Text
  source             String         @default("web_form") @db.VarChar(40)
  utm                Json?
  status             LeadStatus     @default(NEW)
  lostReason         String?        @db.VarChar(255)
  assignedToId       String?
  convertedStudentId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subject            Subject?       @relation(fields: [subjectId], references: [id])
  course             Course?        @relation(fields: [courseId], references: [id])
  assignedTo         User?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  convertedStudent   User?          @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  activities         LeadActivity[]

  @@index([phone])
  @@index([status, createdAt])
  @@index([subjectId, createdAt]) // lọc lead theo môn
  @@index([courseId]) // gỡ tham chiếu khi xóa khóa học
  @@map("leads")
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  actorId   String?
  type      LeadActivityType
  content   String           @db.Text
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Assignment {
  id                 String           @id @default(cuid())
  classId            String
  createdById        String
  title              String           @db.VarChar(200)
  instructions       String           @db.Text
  dueAt              DateTime
  allowLate          Boolean          @default(false)
  // Nhận bài nộp dạng file/ảnh. Bài không có câu hỏi → GV chấm một điểm tổng trong [0, manualMaxScore].
  acceptsFiles       Boolean          @default(false)
  manualMaxScore     Float?
  status             AssignmentStatus @default(DRAFT)
  resultsPublishedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  class              Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy          User             @relation(fields: [createdById], references: [id])
  questions          Question[]
  submissions        Submission[]
  files              StoredFile[]

  @@index([classId, status])
  @@map("assignments")
}

model Question {
  id              String       @id @default(cuid())
  assignmentId    String
  order           Int          @db.SmallInt
  type            QuestionType
  prompt          String       @db.Text
  options         Json? // string[] cho MCQ
  correctOption   Int?         @db.SmallInt // chỉ số 0-based cho MCQ
  acceptedAnswers Json? // string[] cho SHORT
  points          Float
  assignment      Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers         Answer[]
  files           StoredFile[] // ảnh bài làm câu tự luận (cùng `submissionId`)

  @@index([assignmentId, order])
  @@map("questions")
}

model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  status         SubmissionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  isLate         Boolean          @default(false)
  score          Float?
  teacherComment String?          @db.Text
  gradedAt       DateTime?
  gradedById     String?
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User             @relation("SubmissionStudent", fields: [studentId], references: [id])
  gradedBy       User?            @relation("SubmissionGrader", fields: [gradedById], references: [id])
  answers        Answer[]
  files          StoredFile[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Answer {
  id            String     @id @default(cuid())
  submissionId  String
  questionId    String
  response      String?    @db.Text
  autoPoints    Float?
  teacherPoints Float?
  feedback      String?    @db.Text
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("answers")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String   @db.VarChar(40)
  detail    Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action, createdAt]) // nhật ký lọc theo loại thao tác
  @@map("audit_logs")
}

/// Metadata tệp tải lên. Nội dung nằm ở `file_blobs` để truy vấn danh sách không bao giờ kéo dữ liệu nhị phân.
/// Mỗi tệp thuộc đúng một chủ sở hữu (bài tập / bài nộp / tài liệu / tin nhắn / ảnh đại diện) — quyền tải xuống suy ra từ chủ sở hữu.
/// Ảnh câu tự luận: `submissionId` + `questionId` (quyền như bài nộp).
model StoredFile {
  id           String      @id @default(cuid())
  fileName     String      @db.VarChar(200)
  mimeType     String      @db.VarChar(120)
  size         Int
  uploadedById String
  assignmentId String?
  submissionId String?
  questionId   String?
  documentId   String?
  messageId    String?
  createdAt    DateTime    @default(now())
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question?   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  message      Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  avatarOf     User?       @relation("UserAvatar")
  blob         FileBlob?

  @@index([assignmentId])
  @@index([submissionId, questionId])
  @@index([documentId])
  @@index([messageId])
  @@map("stored_files")
}

model FileBlob {
  fileId String     @id
  data   Bytes
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_blobs")
}

/// Đề xuất của giáo viên cho một buổi dạy: xin nghỉ hoặc dời buổi. Giáo vụ/Admin duyệt.
model ScheduleRequest {
  id               String              @id @default(cuid())
  sessionId        String
  teacherId        String
  type             ScheduleRequestType
  proposedStartsAt DateTime?
  proposedEndsAt   DateTime?
  reason           String              @db.VarChar(500)
  status           RequestStatus       @default(PENDING)
  responseNote     String?             @db.VarChar(500)
  handledById      String?
  handledAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  session          ClassSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher          User                @relation("ScheduleRequestTeacher", fields: [teacherId], references: [id])
  handledBy        User?               @relation("ScheduleRequestHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([teacherId, createdAt])
  @@index([sessionId])
  @@map("schedule_requests")
}

/// Đơn xin nghỉ một buổi học do phụ huynh gửi cho con. GV lớp hoặc giáo vụ duyệt → điểm danh "Có phép".
model LeaveRequest {
  id            String        @id @default(cuid())
  sessionId     String
  studentId     String
  requestedById String
  reason        String        @db.VarChar(500)
  status        RequestStatus @default(PENDING)
  responseNote  String?       @db.VarChar(500)
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  session       ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student       User          @relation("LeaveStudent", fields: [studentId], references: [id])
  requestedBy   User          @relation("LeaveRequester", fields: [requestedById], references: [id])
  handledBy     User?         @relation("LeaveHandler", fields: [handledById], references: [id])

  @@index([sessionId])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("leave_requests")
}

/// Giáo trình, tài liệu học tập, giáo án. Nội dung là tệp tải lên (`files`) và/hoặc đường dẫn ngoài (`url`).
model Document {
  id                String          @id @default(cuid())
  kind              DocumentKind
  title             String          @db.VarChar(200)
  description       String?         @db.Text
  url               String?         @db.VarChar(500)
  subjectId         String?
  levelId           String?
  sessionId         String? // giáo án / tài liệu cho một buổi
  ownerId           String
  visibleToStudents Boolean         @default(true)
  visibleToParents  Boolean         @default(false)
  isActive          Boolean         @default(true) // ngừng sử dụng: ẩn khỏi HS/PH/GV, quản lý vẫn thấy
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subject           Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  level             EducationLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  session           ClassSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  owner             User            @relation(fields: [ownerId], references: [id])
  files             StoredFile[]
  shares            DocumentShare[]

  @@index([kind, isActive])
  @@index([ownerId])
  @@index([subjectId])
  @@map("documents")
}

/// Chia sẻ / phân phối tài liệu cho một lớp. Gỡ chia sẻ = xóa dòng (tệp gốc giữ nguyên).
model DocumentShare {
  documentId String
  classId    String
  sharedById String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  sharedBy   User     @relation(fields: [sharedById], references: [id])

  @@id([documentId, classId])
  @@index([classId])
  @@map("document_shares")
}

/// Thông báo do người dùng soạn. Người nhận được tính lúc gửi và ghi thành `notifications` (fan-out).
model Announcement {
  id             String               @id @default(cuid())
  authorId       String
  audience       AnnouncementAudience
  classId        String?
  title          String               @db.VarChar(200)
  body           String               @db.Text
  recipientCount Int                  @default(0)
  createdAt      DateTime             @default(now())
  author         User                 @relation(fields: [authorId], references: [id])
  class          Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("announcements")
}

/// Hộp thư thông báo của từng người: từ `Announcement` hoặc sự kiện hệ thống (đổi lịch, kết quả đơn, nhắc nộp bài…).
model Notification {
  id             String        @id @default(cuid())
  userId         String
  announcementId String?
  kind           String        @db.VarChar(40)
  title          String        @db.VarChar(200)
  body           String        @db.Text
  link           String?       @db.VarChar(300)
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([announcementId])
  @@map("notifications")
}

/// Đánh giá định kỳ của giáo viên cho học sinh trong một lớp. Chỉ bản SENT hiện cho HS/PH.
model Evaluation {
  id           String           @id @default(cuid())
  classId      String
  studentId    String
  teacherId    String
  period       String           @db.VarChar(40) // vd. "Tháng 10/2026", "Giữa khóa"
  content      String           @db.Text
  strengths    String?          @db.Text
  improvements String?          @db.Text
  status       EvaluationStatus @default(DRAFT)
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  class        Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      User             @relation("EvaluationStudent", fields: [studentId], references: [id])
  teacher      User             @relation("EvaluationTeacher", fields: [teacherId], references: [id])

  @@unique([classId, studentId, period])
  @@index([studentId, status])
  @@map("evaluations")
}

/// Cuộc trò chuyện: DIRECT (2 người, `directKey` = 2 id đã sắp xếp) hoặc CLASS (nhóm lớp, thành viên suy ra từ lớp).
model Conversation {
  id            String               @id @default(cuid())
  kind          ConversationKind
  classId       String?              @unique
  directKey     String?              @unique @db.VarChar(90)
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  class         Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

/// DIRECT: hai thành viên. CLASS: dòng chỉ để lưu `lastReadAt` (tạo khi người dùng mở nhóm).
model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  files          StoredFile[] // ảnh/tệp đính kèm (body có thể rỗng khi chỉ gửi tệp)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Đăng ký thông báo đẩy (Web Push) của một trình duyệt/thiết bị. Endpoint hết hạn (404/410) bị xóa khi gửi.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model RateLimitBucket {
  key     String   @id @db.VarChar(120)
  count   Int
  resetAt DateTime

  @@index([resetAt]) // dọn bucket hết hạn
  @@map("rate_limit_buckets")
}
