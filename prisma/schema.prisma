generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model absence_requests {
  id             String         @id @default(dbgenerated("(uuid())")) @db.Char(36)
  session_id     String         @db.Char(36)
  student_id     String         @db.Char(36)
  requested_by   String         @db.Char(36)
  reason         String         @db.VarChar(500)
  created_at     DateTime       @default(now())
  class_sessions class_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_abs_session")
  students       students       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_abs_student")
  users          users          @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_abs_user")

  @@unique([session_id, student_id], map: "uq_abs")
  @@index([student_id], map: "fk_abs_student")
  @@index([requested_by], map: "fk_abs_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ai_jobs {
  id                     String                   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  branch_id              String                   @db.Char(36)
  feature                String                   @db.VarChar(20)
  provider               String                   @db.VarChar(30)
  model                  String                   @db.VarChar(60)
  status                 ai_jobs_status           @default(queued)
  input_tokens           Int                      @default(0)
  output_tokens          Int                      @default(0)
  audio_seconds          Int                      @default(0)
  cost_usd               Decimal                  @default(0.00000) @db.Decimal(10, 5)
  entity                 String?                  @db.VarChar(60)
  entity_id              String?                  @db.Char(36)
  request_log            Json?
  response_log           Json?
  error_message          String?                  @db.VarChar(1000)
  created_by             String?                  @db.Char(36)
  created_at             DateTime                 @default(now())
  finished_at            DateTime?
  branches               branches                 @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ai_jobs_branch")
  users                  users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ai_jobs_user")
  answers                answers[]
  chat_turns             chat_turns[]
  curriculum_suggestions curriculum_suggestions[]
  monthly_reports        monthly_reports[]
  videos                 videos[]

  @@index([created_by], map: "fk_ai_jobs_user")
  @@index([branch_id, created_at], map: "ix_ai_jobs_cost")
  @@index([entity, entity_id], map: "ix_ai_jobs_entity")
}

model announcement_reads {
  announcement_id String        @db.Char(36)
  user_id         String        @db.Char(36)
  read_at         DateTime      @default(now())
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ar_ann")
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_user")

  @@id([announcement_id, user_id])
  @@index([user_id], map: "fk_ar_user")
}

